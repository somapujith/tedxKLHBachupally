DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PORT=3001

# --- Razorpay ---
# Dashboard -> Settings -> API Keys (use rzp_test_ until go-live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard -> Settings -> Webhooks (the secret you set on the webhook)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# Public key id for the browser Checkout — same value as RAZORPAY_KEY_ID
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# --- Auth / signing secrets ---
# Both MUST be >= 32 random bytes (e.g. `openssl rand -base64 48`). Never reuse.
TICKET_JWT_SECRET=change-me-32-plus-random-bytes
ADMIN_JWT_SECRET=change-me-32-plus-random-bytes

# --- Email (Mailchimp Transactional / Mandrill) ---
MAILCHIMP_TRANSACTIONAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=tickets@tedxklhbachupally.com

# --- Event capacity ---
# Max paid seats. 0 = event closed. Unset/invalid falls back to 250.
SEAT_CAPACITY=250

# --- Admin CORS allow-list ---
# Comma-separated origins allowed to call the /api/admin/* endpoints. The request
# Origin is echoed back only when it matches; otherwise the first entry is used.
# Leave unset only for local dev.
ADMIN_ALLOWED_ORIGIN=https://admin.tedxklhbachupally.com

# --- Public CORS allow-list ---
# Comma-separated origins allowed to call the public /api/* endpoints (register,
# payment, contact). Falls back to ADMIN_ALLOWED_ORIGIN if unset, and to echoing
# the caller's origin only when NEITHER is set (local dev). Set this in production.
PUBLIC_ALLOWED_ORIGIN=https://tedxklhbachupally.com

# --- Rate limiting (Vercel serverless) ---
# The api/* handlers rate-limit per-IP using Upstash Redis so counts are shared
# across all function instances (in-memory limiting does NOT work on serverless).
# Create a free database at https://console.upstash.com/redis and paste the REST
# URL + token below. If BOTH are left unset, rate limiting is DISABLED (fine for
# local dev; the atomic DB gates still prevent oversell/double-charge either way).
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Per-IP request caps (requests per window). Defaults shown; tune for launch load.
# The window is shared across all classes.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER=10        # POST /api/register
RATE_LIMIT_PAYMENT=20         # POST /api/payment/order + /verify
RATE_LIMIT_CONTACT=5          # POST /api/contact
RATE_LIMIT_LOGIN=10           # POST /api/admin/login (credential-stuffing guard)
RATE_LIMIT_ADMIN=120          # authenticated admin actions (stats/list/checkin/resend)
RATE_LIMIT_WEBHOOK=300        # POST /api/payment/webhook (absorb Razorpay retries)

# Max accepted JSON request body size in bytes (larger bodies get a 413). 16 KB default.
MAX_BODY_BYTES=16384

# --- Upstream timeouts (Vercel serverless) ---
# Abort a Razorpay API call after this long so a slow upstream cannot hang a
# function until the platform limit. Idempotent reads (payments.fetch) retry;
# order creation only times out (retrying would mint a duplicate order).
RAZORPAY_TIMEOUT_MS=10000
