{
  "redirects": [
    { "source": "/about-ted", "destination": "/about-tedxklh", "permanent": true },
    { "source": "/about-tedx", "destination": "/about-tedxklh", "permanent": true }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
